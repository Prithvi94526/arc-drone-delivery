<?xml version="1.0"?>
<!--
  Search-and-land world, Gazebo Harmonic: ground, sun, the AprilTag pad and
  the aircraft standing on it. Converted from ../../worlds/apriltag_landing.world.

  The geodetic origin is PX4's default (the same one Gazebo Classic used when
  no origin was given), so the delivery example in delivery.launch.py's
  docstring still lands near home.

  Run from the repo root:
    navigation-stack/sim/gz/run_sitl.sh apriltag_landing
-->
<sdf version="1.9">
  <world name="apriltag_landing">
    <!-- PX4's stock Harmonic physics (Tools/simulation/gz/worlds/default.sdf).
         Do not coarsen the step. On Gazebo Classic a 10 ms step left the
         airframe under-resolved on its legs, the accelerometer read
         -8.3 m/s^2 at rest, and EKF2 refused preflight with "High
         Accelerometer Bias" (see ../../worlds/README.md). -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <!-- No <plugin> elements, deliberately. A world with none gets the
         system plugins from PX4's server.config (physics, sensors with
         ogre2, navsat, GstCameraSystem, ...). Declaring any plugin here
         replaces that whole list, and the camera stream and GPS go with it. -->

    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- AprilTag 36h11 id 0 landing pad: a 0.5 m square whose black quad is
         0.4 m (tag_size_m). Classic used an OGRE material script, which
         Harmonic cannot read; this is the same PNG as a PBR albedo map, the
         way PX4's own arucotag model does it. -->
    <model name="Apriltag_36_11_00000">
      <static>true</static>
      <pose>0 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>0.5 0.5</size>
            </plane>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://Apriltag36_11_00000/materials/textures/tag36_11_00000.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- The aircraft, standing on the pad. PX4 attaches to it by name
         (PX4_GZ_MODEL_NAME=arc_x500_0 in run_sitl.sh) rather than spawning
         one, so where it starts is decided here and nowhere else. -->
    <include>
      <uri>model://arc_x500</uri>
      <name>arc_x500_0</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
